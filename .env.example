OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_SYSTEM_PROMPT=Eres Dagerbot. Responde en espanol y se conciso.
PORT=3000
MAX_INPUT_CHARS=4096
HISTORY_LIMIT=10
SESSION_TTL_SECONDS=3600
RATE_LIMIT_IP_PER_MIN=60
RATE_LIMIT_SESSION_PER_MIN=100

# Required for database-backed settings and meme counts
MONGODB_URI=mongodb://localhost:27017/dagerbot

# Discord bot
# DISCORD_BOT_ENABLED=true # Set to false to disable bot gateway connection entirely
# DISCORD_MESSAGE_CONTENT=true # Set to false if pending Discord Privileged Intent verification
DISCORD_TOKEN=your_discord_bot_token
DISCORD_PREFIX=!

# Required for slash command registration
DISCORD_CLIENT_ID=your_bot_client_id

# Permission required to use /config commands
# Options: Administrator, ManageGuild, BanMembers, KickMembers, ModerateMembers, ManageChannels
# Default: Administrator
CONFIG_PERMISSION=Administrator

# Optional: commands register instantly to this guild (use for development only)
# Dev only: remove/comment in production.
DISCORD_GUILD_ID=your_test_guild_id
